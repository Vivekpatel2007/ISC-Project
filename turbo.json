{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "dev:check": {
      "cache": false
    },
    "dev:frontend": {
      "dependsOn": ["dev:check"],
      "cache": false,
      "persistent": true
    },
    "dev:backend": {
      "dependsOn": ["dev:check"],
      "cache": false,
      "persistent": true
    }
  }
}
