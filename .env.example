# =====================================================================
# ISC Project: Secure Storage & Transmission Environment Configuration
# =====================================================================
# WARNING: DO NOT COMMIT REAL KEYS OR THE ACTUAL .env FILE TO VERSION CONTROL!
#
# To generate a new 256-bit cryptographically secure key, run:
#   .\.venv\Scripts\python.exe -c "from src.security.key_manager import generate_key, key_to_base64; print(key_to_base64(generate_key()))"
#
# Then copy this file to .env and paste the generated base64 key below:
# =====================================================================

# 256-bit AES-GCM Encryption Key (Base64 URL-safe encoded, exactly 32 raw bytes)
IMAGE_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_BASE64_256BIT_KEY

# Secure storage root directory for encrypted medical images
SECURE_STORAGE_DIR=secure_data/encrypted_images

# SQLite metadata database path
METADATA_DB_PATH=secure_data/metadata.db

# Maximum upload image file size in bytes (Default: 20 MB = 20971520 bytes)
MAX_IMAGE_SIZE_BYTES=20971520
