# =====================================================================
# ISC Project: Secure Storage and Transmission Environment Configuration
# =====================================================================
# WARNING: DO NOT COMMIT REAL KEYS OR THE ACTUAL .env FILE TO VERSION CONTROL!
#
# To generate a new 256-bit cryptographically secure key, run:
#   .\.venv\Scripts\python.exe -c "from src.security.key_manager import generate_key, key_to_base64; print(key_to_base64(generate_key()))"
#
# To generate a secure random JWT secret key, run:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
# =====================================================================

# --- Phase 1: Cryptography & Storage ---
# 256-bit AES-GCM Encryption Key (Base64 URL-safe encoded, exactly 32 raw bytes)
IMAGE_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_BASE64_256BIT_KEY

# Secure storage root directory for encrypted medical images
SECURE_STORAGE_DIR=secure_data/encrypted_images

# SQLite metadata database path
METADATA_DB_PATH=secure_data/metadata.db

# Maximum upload image file size in bytes (Default: 20 MB = 20971520 bytes)
MAX_IMAGE_SIZE_BYTES=20971520

# --- Phase 2: FastAPI Backend & JWT Authentication ---
# Secret key used to sign and verify HMAC-SHA256 JWT access tokens (min 32 chars)
JWT_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY

# Token expiration time in minutes (Default: 30 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Allowed CORS origins for frontend integration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Trained Model Checkpoint Path
MODEL_CHECKPOINT_PATH=models/densenet121_pneumonia_best.pth
